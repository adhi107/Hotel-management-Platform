# AURA Restaurant OS - Environment Configuration Example

# Backend Core
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="AURA Restaurant OS - Enterprise Multi-Tenant Platform"
VERSION=1.0.0
API_V1_STR=/api/v1

# Security & JWT
SECRET_KEY=aura_super_secret_jwt_signing_key_2026_enterprise_grade_security
REFRESH_SECRET_KEY=aura_super_secret_refresh_jwt_key_2026_rotation_secure
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database & Cache
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=restaurant_os_db
REDIS_URL=redis://localhost:6379/0

# Fallbacks for zero-setup demo
USE_IN_MEMORY_DB_FALLBACK=true
USE_IN_MEMORY_REDIS_FALLBACK=true

# AI Assistant
AI_ENABLED=true
AI_MODEL=gemini-pro
